// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tablas y modelos

model DockerContainer {
  id          Int        @id @default(autoincrement())
  containerId String     @unique
  name        String
  status      String
  image       String
  createdAt   DateTime   @default(now())

  logs        LogEntry[]
  alerts      Alert[]
}

model LogEntry {
  id          Int            @id @default(autoincrement())
  containerId String
  message     String
  level       String
  timestamp   DateTime       @default(now())

  container   DockerContainer @relation(fields: [containerId], references: [containerId])
}

model Alert {
  id          Int            @id @default(autoincrement())
  containerId String
  name        String
  condition   String
  threshold   Float
  createdAt   DateTime       @default(now())

  container   DockerContainer @relation(fields: [containerId], references: [containerId])
}